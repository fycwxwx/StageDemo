<Window x:Class="Stage1.MvvmDiDemo.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="阶段① PLC 连接面板（MVVM + DI Demo）"
        Height="480" Width="640"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Window.Resources>
        <!-- 状态指示灯的样式：默认红色，IsConnected=true 时变绿 -->
        <Style x:Key="StatusLampStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Fill" Value="#E53935"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter Property="Fill" Value="#43A047"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 参数区 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDE2E9"
                BorderThickness="1" CornerRadius="6" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="PLC IP："
                           VerticalAlignment="Center" Margin="0,6"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Ip, UpdateSourceTrigger=PropertyChanged}"
                         Height="32" VerticalContentAlignment="Center" Margin="0,6"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="端口："
                           VerticalAlignment="Center" Margin="16,6,0,6"/>
                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                         Width="100" Height="32" VerticalContentAlignment="Center" Margin="0,6"/>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="4"
                            Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="连接 PLC"
                            Command="{Binding ConnectCommand}"
                            Width="110" Height="36"
                            Background="#1E88E5" Foreground="White"
                            BorderThickness="0" Cursor="Hand"/>
                    <Button Content="断开 PLC"
                            Command="{Binding DisconnectCommand}"
                            Width="110" Height="36" Margin="10,0,0,0"
                            Background="#E53935" Foreground="White"
                            BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 状态条 -->
        <Border Grid.Row="1" Margin="0,12,0,0"
                Background="White" BorderBrush="#DDE2E9"
                BorderThickness="1" CornerRadius="6" Padding="16">
            <StackPanel Orientation="Horizontal">
                <Ellipse Style="{StaticResource StatusLampStyle}"
                         VerticalAlignment="Center"/>
                <TextBlock Text="状态："
                           VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#666"/>
                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center" FontWeight="Bold"
                           Foreground="#1E3A5F"/>
            </StackPanel>
        </Border>

        <!-- 日志区 -->
        <Border Grid.Row="2" Margin="0,12,0,0"
                Background="White" BorderBrush="#DDE2E9"
                BorderThickness="1" CornerRadius="6" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="操作日志" FontWeight="Bold"
                           Foreground="#1E88E5" Margin="4,0,0,6"/>
                <TextBox Grid.Row="1"
                         Text="{Binding LogText, Mode=OneWay}"
                         IsReadOnly="True" Background="#F5F7FA"
                         BorderThickness="0" FontFamily="Consolas"
                         FontSize="12" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>
    </Grid>
</Window>